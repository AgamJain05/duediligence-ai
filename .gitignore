# ─── Secrets ──────────────────────────────────────────────────────────────────
.env                        # API keys — NEVER commit this

# ─── Generated index files (rebuilt by scripts/ingest.py) ────────────────────
data/index/faiss.index
data/index/chunks.json

# ─── Raw documents (may be confidential) ─────────────────────────────────────
data/raw/*.pdf
data/raw/*.docx
data/raw/*.txt
# Keep the placeholder so the directory is tracked
!data/raw/.gitkeep

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ─── Testing & coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ─── IDEs & editors ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── HuggingFace model cache (large, re-downloaded on demand) ────────────────
# These live in ~/.cache/huggingface — not in the project, but just in case:
*.bin
*.safetensors

# ─── Jupyter (if used for exploration) ───────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
.env
.env.example
